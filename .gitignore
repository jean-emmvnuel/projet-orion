.installed.cfg
*.egg
MANIFEST

# --- Environnements virtuels ---
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Variables d'environnement & Secrets (CRITIQUE SÉCURITÉ) ---
.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
*.crt
*.cert
*.p12
*.pfx
secrets/

# --- Fichiers reçus et téléchargements runtime ---
reçus/
Bot/reçus/
inbox/
storage/
temp/
*.log
logs/

# --- Outils de qualité & tests ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Flet & Mobile / Android ---
.flet/
*.apk
*.aab
.gradle/
local.properties
android/.gradle/
android/app/build/
android/local.properties

# --- Bases de données & stockage local ---
*.sqlite
*.sqlite3
*.db
qdrant_storage/

# --- Infrastructure & Mosquitto ---
infra/mosquitto/certs/
infra/mosquitto/passwd

# --- IDEs & Éditeurs ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

