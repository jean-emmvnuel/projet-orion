# ORION Core — variables d'environnement (copier en .env)
PORT=3001
NODE_ENV=development
# PostgreSQL (dev : base créée avec le rôle orion, cf. README)
DATABASE_URL=postgresql://orion:orion_dev_password@localhost:5432/orion
# Secret JWT des comptes : au moins 32 caractères aléatoires (openssl rand -hex 32)
JWT_SECRET=change-me
# Secret de signature des liens de téléchargement (openssl rand -hex 32)
FILES_SECRET=change-me-too
# Dossier de stockage temporaire des fichiers en transit
FILES_DIR=./storage
# Origines autorisées (séparées par des virgules) ; l'app mobile n'en a pas besoin
CORS_ORIGINS=http://localhost:8081
